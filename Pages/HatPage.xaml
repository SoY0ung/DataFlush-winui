<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataFlushWinUI.Pages.HatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="HatImageTemplate">
            <StackPanel Width="{Binding ThumbnailWidth}" Margin="4">
                <Border Height="{Binding ThumbnailHeight}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Image Source="{Binding ImageUri}" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="HatPreviewItemsPanel">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid Padding="18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SyncPairCheck" Content="同步展示对应分类" Checked="SyncPairCheck_Changed" Unchecked="SyncPairCheck_Changed" VerticalAlignment="Center" />
            <InfoBar
                x:Name="HatToastBar"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="640"
                Visibility="Collapsed"
                IsOpen="False"
                IsClosable="True"
                CloseButtonClick="HatToastBar_CloseButtonClick" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="PreviewToggle" Click="PreviewToggle_Click" MinHeight="32" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE890;" FontSize="14" />
                        <TextBlock Text="预览窗口" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="UndoButton" Click="Undo_Click" MinHeight="32" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        <TextBlock Text="撤销" />
                    </StackPanel>
                </Button>
                <Button x:Name="DisableHatButton" Click="DisableHat_Click" MinHeight="32" Padding="10,4" Background="#C83232" Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        <TextBlock Text="清除并停用" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="UnavailablePane" Grid.Row="1" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <FontIcon Glyph="&#xE7BE;" FontFamily="Segoe Fluent Icons" FontSize="72" />
                <TextBlock x:Name="UnavailableTitle" Text="帽子分类不可用" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="UnavailableMessage" Text="请先前往清洗分类选择数据集和 CSV。" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="EnablePane" Grid.Row="1" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <FontIcon Glyph="&#xE7BE;" FontFamily="Segoe Fluent Icons" FontSize="84" />
                <TextBlock Text="帽子分类" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="帽子分类会对以下分类建立新的CSV文件来细化清洗" FontSize="18" HorizontalAlignment="Center" />
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="00 正常 → h0 帽子正常" HorizontalAlignment="Center" />
                    <TextBlock Text="01 部分遮挡 → h1 帽子遮挡" HorizontalAlignment="Center" />
                    <TextBlock Text="05 中间角度 → h5 帽子中间角度" HorizontalAlignment="Center" />
                </StackPanel>
                <Button Content="启动帽子分类" Click="EnableHat_Click" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkPane" Grid.Row="1" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="1*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="RightColumn" Width="1*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="类别" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LeftClass" Width="180" SelectionChanged="PaneClass_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="LeftStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <DropDownButton Grid.Column="2" ToolTipService.ToolTip="缩放" Padding="8,4" MinWidth="58" MinHeight="32">
                        <DropDownButton.Content><FontIcon Glyph="&#xE8A3;" FontFamily="Segoe Fluent Icons" FontSize="16" /></DropDownButton.Content>
                        <DropDownButton.Flyout><Flyout><StackPanel Spacing="10" Padding="4" MinWidth="132"><TextBlock Text="缩放(Ctrl+滚轮)" FontWeight="SemiBold"/><Slider x:Name="LeftZoom" Minimum="80" Maximum="220" Value="132" Width="132" ValueChanged="Zoom_ValueChanged"/></StackPanel></Flyout></DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <Grid Grid.Row="1">
                    <GridView x:Name="LeftList" Background="Transparent" SelectionMode="Extended" IsItemClickEnabled="True" CanDragItems="True" AllowDrop="True" ItemTemplate="{StaticResource HatImageTemplate}" ItemsPanel="{StaticResource HatPreviewItemsPanel}" ItemClick="Image_ItemClick" SelectionChanged="PaneSelection_SelectionChanged" RightTapped="Pane_RightTapped" />
                    <Canvas IsHitTestVisible="False"><Border x:Name="LeftSelectionRect" Visibility="Collapsed" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" Background="#332EA043" CornerRadius="3" /></Canvas>
                </Grid>
            </Grid>

            <primitives:Thumb Grid.Column="1" DragDelta="VerticalSplitter_DragDelta" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="类别" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RightClass" Width="180" SelectionChanged="PaneClass_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="RightStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <DropDownButton Grid.Column="2" ToolTipService.ToolTip="缩放" Padding="8,4" MinWidth="58" MinHeight="32">
                        <DropDownButton.Content><FontIcon Glyph="&#xE8A3;" FontFamily="Segoe Fluent Icons" FontSize="16" /></DropDownButton.Content>
                        <DropDownButton.Flyout><Flyout><StackPanel Spacing="10" Padding="4" MinWidth="132"><TextBlock Text="缩放(Ctrl+滚轮)" FontWeight="SemiBold"/><Slider x:Name="RightZoom" Minimum="80" Maximum="220" Value="132" Width="132" ValueChanged="Zoom_ValueChanged"/></StackPanel></Flyout></DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <Grid Grid.Row="1">
                    <GridView x:Name="RightList" Background="Transparent" SelectionMode="Extended" IsItemClickEnabled="True" CanDragItems="True" AllowDrop="True" ItemTemplate="{StaticResource HatImageTemplate}" ItemsPanel="{StaticResource HatPreviewItemsPanel}" ItemClick="Image_ItemClick" SelectionChanged="PaneSelection_SelectionChanged" RightTapped="Pane_RightTapped" />
                    <Canvas IsHitTestVisible="False"><Border x:Name="RightSelectionRect" Visibility="Collapsed" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" Background="#332EA043" CornerRadius="3" /></Canvas>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>

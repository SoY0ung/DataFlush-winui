<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataFlushWinUI.Pages.AiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AiImageTemplate">
            <StackPanel Width="{Binding ThumbnailWidth}" Margin="4">
                <Border Height="{Binding ThumbnailHeight}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Image Source="{Binding ImageUri}" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ModelClassTemplate">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Column="2" MinWidth="72" Height="28" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PendingText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <FontIcon Grid.Column="3" Glyph="&#xE974;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="AiSelector" SelectionChanged="AiSelector_SelectionChanged">
                <SelectorBarItem x:Name="ModelSelectorItem" Text="模型分类" IsSelected="True" />
                <SelectorBarItem x:Name="BrowseSelectorItem" Text="图片浏览" />
                <SelectorBarItem x:Name="ThresholdSelectorItem" Text="阈值过滤" />
                <SelectorBarItem x:Name="StatusSelectorItem" Text="任务状态" />
            </SelectorBar>
            <InfoBar
                x:Name="AiToastBar"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="640"
                MinWidth="320"
                IsOpen="False"
                Severity="Success"
                Visibility="Collapsed"
                CloseButtonClick="AiToastBar_CloseButtonClick" />
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button x:Name="OpenCsvFolderButton" Click="OpenCsvFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        <TextBlock Text="打开CSV目录" />
                    </StackPanel>
                </Button>
                <Button Click="RefreshClassStatus_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        <TextBlock Text="刷新分类状态" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="ModelClassList" IsItemClickEnabled="True" ItemClick="ModelClassList_ItemClick" ItemTemplate="{StaticResource ModelClassTemplate}" Padding="0" />

            <Grid x:Name="BrowsePane" Visibility="Collapsed" ColumnSpacing="8" SizeChanged="BrowsePane_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="AiBrowseLeftColumn" Width="2*" MinWidth="360" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition x:Name="AiBrowseRightColumn" Width="1*" MinWidth="320" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="AiFilterLabel" Text="类别" VerticalAlignment="Center" />
                            <ComboBox x:Name="AiClassFilter" Width="180" SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="AiThresholdFilter" Width="180" Visibility="Collapsed" SelectionChanged="Filter_Changed" />
                        </StackPanel>
                        <TextBlock x:Name="AiSelectionStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="总数：0，已选：0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <CheckBox x:Name="HideClassified" Content="隐藏已分类项" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                            <CheckBox x:Name="DisableThresholdChoiceCheck" Content="禁用阈值与预测选择" Visibility="Collapsed" IsEnabled="False" Checked="ThresholdState_Changed" Unchecked="ThresholdState_Changed" />
                            <DropDownButton x:Name="AiZoomButton" MinWidth="58" MinHeight="32" Padding="8,4" ToolTipService.ToolTip="缩放">
                                <DropDownButton.Content>
                                    <FontIcon Glyph="&#xE8A3;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                                </DropDownButton.Content>
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="10" Padding="4" MinWidth="150">
                                            <TextBlock Text="缩放(Ctrl+滚轮)" FontWeight="SemiBold" />
                                            <Slider x:Name="AiZoom" Minimum="80" Maximum="220" Value="132" Width="150" ValueChanged="AiZoom_ValueChanged" />
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <GridView x:Name="AiGrid" SelectionMode="Extended" IsItemClickEnabled="True" CanDragItems="True" AllowDrop="True" ItemClick="AiGrid_ItemClick" RightTapped="AiGrid_RightTapped" SelectionChanged="AiGrid_SelectionChanged" PointerPressed="AiGrid_PointerPressed" PointerMoved="AiGrid_PointerMoved" PointerReleased="AiGrid_PointerReleased" PointerCanceled="AiGrid_PointerCanceled" ItemTemplate="{StaticResource AiImageTemplate}" />
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="AiSelectionRect" Visibility="Collapsed" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" Background="#332EA043" CornerRadius="3" />
                        </Canvas>
                    </Grid>
                </Grid>
                <primitives:Thumb Grid.Column="1" DragDelta="AiVerticalSplitter_DragDelta" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Grid Grid.Column="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="AiInfoTopRow" Height="1*" MinHeight="200" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="1*" MinHeight="200" />
                    </Grid.RowDefinitions>
                    <Border x:Name="AiInfoBorder" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="ThresholdTopControls" Grid.Row="0" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Stretch">
                                <ItemsControl HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ThresholdMappingHelpButton" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="ThresholdMappingHelpButton_Click" ToolTipService.ToolTip="分类映射">
                                            <FontIcon Glyph="&#xE897;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="数据集类别" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <ComboBox Grid.Column="2" x:Name="ThresholdDatasetClassBox" MinWidth="120" MaxWidth="180" Margin="6,0,0,0" SelectionChanged="ThresholdState_Changed" />
                                        <TeachingTip x:Name="ThresholdMappingTeachingTip" Target="{Binding ElementName=ThresholdMappingHelpButton}" Title="分类映射" PreferredPlacement="Bottom" IsLightDismissEnabled="True" CloseButtonContent="知道了">
                                            <RichTextBlock x:Name="ThresholdMappingText" MaxWidth="360" TextWrapping="Wrap" />
                                        </TeachingTip>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2" VerticalAlignment="Center">
                                    <TextBlock Text="置信度阈值" VerticalAlignment="Center" />
                                        <NumberBox x:Name="ThresholdValueBox" Minimum="0" Maximum="100" Value="85" MinWidth="84" MaxWidth="120" SmallChange="1" LargeChange="10" ValueChanged="ThresholdValueBox_ValueChanged" />
                                    </StackPanel>
                                </ItemsControl>
                                <ItemsControl x:Name="ThresholdRadioLayout" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VariableSizedWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <StackPanel x:Name="ThresholdConfidenceGroup" Orientation="Horizontal" Spacing="0" Margin="0,0,0,4">
                                        <RadioButton x:Name="ThresholdHighRadio" Content="高/等于阈值" GroupName="ThresholdConfidence" IsChecked="True" Checked="ThresholdState_Changed" />
                                        <RadioButton x:Name="ThresholdLowRadio" Content="低于阈值" GroupName="ThresholdConfidence" Checked="ThresholdState_Changed" />
                                    </StackPanel>
                                    <StackPanel x:Name="ThresholdCorrectnessGroup" Orientation="Horizontal" Spacing="0" Margin="0,0,0,4">
                                        <RadioButton x:Name="ThresholdCorrectRadio" Content="预测正确" GroupName="ThresholdCorrectness" IsChecked="True" Checked="ThresholdState_Changed" />
                                        <RadioButton x:Name="ThresholdWrongRadio" Content="预测错误" GroupName="ThresholdCorrectness" Checked="ThresholdState_Changed" />
                                    </StackPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="AiSummaryTitle" Text="选择图片" FontSize="42" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock x:Name="AiSummarySub" FontSize="36" TextAlignment="Center" HorizontalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="AiActionHint" Grid.Row="2" Text="隐藏已分类项来快捷操作。" HorizontalAlignment="Left" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="MappedMoveButtons" Grid.Row="3" Spacing="8" HorizontalAlignment="Center" />
                            <DropDownButton x:Name="MoveAiDropDown" Grid.Row="4" Content="移动到..." HorizontalAlignment="Center" VerticalAlignment="Top" IsEnabled="False" />
                            <Button x:Name="ThresholdLockButton" Grid.Row="4" Content="锁定数据集类别" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Click="ThresholdLockButton_Click" />
                        </Grid>
                    </Border>
                    <primitives:Thumb Grid.Row="1" DragDelta="AiHorizontalSplitter_DragDelta" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Background="Black">
                        <Image x:Name="AiPreviewImage" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Grid>

            <StackPanel x:Name="StatusPane" Visibility="Collapsed" Spacing="16" Padding="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ProgressBar x:Name="AiProgress" Height="18" />
                    <TextBlock x:Name="AiProgressText" Grid.Column="1" Text="进度 0%" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="后台任务" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="AiProcessedText" Text="已处理：0" />
                    <Button x:Name="PauseButton" Content="启动本地推理" Click="PauseButton_Click" />
                </StackPanel>
                <TextBox x:Name="AiErrorLog" Header="错误日志" AcceptsReturn="True" TextWrapping="Wrap" Height="300" IsReadOnly="True" />
                <Button Content="复制" Click="CopyErrors_Click" HorizontalAlignment="Left" />
            </StackPanel>

            <Grid x:Name="AiLoadingOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.94" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock Text="正在加载 AI 结果..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>

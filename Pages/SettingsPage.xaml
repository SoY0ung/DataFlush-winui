<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataFlushWinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="28,22" Spacing="28" MaxWidth="1040" HorizontalAlignment="Stretch">
            <InfoBar
                x:Name="SettingsInfoBar"
                IsOpen="False"
                Severity="Success"
                IsClosable="True" />

            <StackPanel Spacing="10">
                <TextBlock Text="通用设置" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="操作提示" />
                            <TextBlock Text="每次移动或AI操作时在顶部显示提示框" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="OperationTipsSwitch"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            Toggled="OperationTipsSwitch_Toggled" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="清洗分类" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数据集目录" VerticalAlignment="Center" />
                        <TextBox x:Name="DatasetBox" Grid.Column="1" IsReadOnly="True" MinWidth="360" />
                        <Button Grid.Column="2" Content="浏览" Click="PickDataset_Click" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CSV目录" VerticalAlignment="Center" />
                        <TextBox x:Name="CsvBox" Grid.Column="1" IsReadOnly="True" MinWidth="360" />
                        <Button x:Name="CsvBrowseButton" Grid.Column="2" Content="浏览" Click="PickCsv_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="帽子分类" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="清洗分类页中显示细化分类" />
                            <TextBlock Text="开启后可以在清洗分类页筛选帽子数据" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ShowHatClassesSwitch"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            Toggled="ShowHatClassesSwitch_Toggled" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="AI辅助" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="本地分类模型" />
                            <TextBlock Text="选择ONNX模型进行本地推理" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBox x:Name="LocalModelBox" Grid.Column="1" IsReadOnly="True" MinWidth="420" />
                        <Button Grid.Column="2" Content="浏览" Click="PickLocalModel_Click" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="自动启动推理" />
                            <TextBlock Text="App启动时自动启动ONNX推理任务" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="AutoStartOnnxSwitch"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            Toggled="AutoStartOnnxSwitch_Toggled" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="标准化预处理" />
                            <TextBlock Text="开启时ONNX的输入会进行mean和std的预处理" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="MeanStdPreprocessSwitch"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            Toggled="MeanStdPreprocessSwitch_Toggled" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="预览窗口显示AI辅助信息" />
                            <TextBlock Text="将AI结果显示在预览窗口右侧，在预览窗口中按F可以快速开关" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="PreviewInfoSwitch"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            Toggled="PreviewInfoSwitch_Toggled" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ONNX模型映射规则" />
                            <TextBlock Text="调整ONNX分类结果到清洗所需分类的映射" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="调整" Click="EditOnnxMapping_Click" />
                    </Grid>
                </Border>
                <Border Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Base URL" />
                            <TextBlock Text="Dify平台的API网址" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBox x:Name="BaseUrlBox" Grid.Column="1" MinWidth="420" TextChanged="Settings_TextChanged" />
                    </Grid>
                </Border>
                <Border Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="API KEY" />
                            <TextBlock Text="Dify平台上申请的访问密钥" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Grid Grid.Column="1" MinWidth="420">
                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />
                            <TextBox x:Name="ApiKeyPlainBox" Visibility="Collapsed" TextChanged="Settings_TextChanged" />
                        </Grid>
                        <ToggleButton x:Name="ApiKeyVisible" Grid.Column="2" Click="ApiKeyVisible_Click" ToolTipService.ToolTip="显示/隐藏 API KEY">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE052;" FontSize="16" />
                        </ToggleButton>
                    </Grid>
                </Border>
                <Border Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="系统健康度测试" />
                            <TextBlock x:Name="HealthDescription" Text="测试提供的API服务和密钥是否可用" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ProgressRing x:Name="HealthRing" Width="24" Height="24" IsActive="False" />
                            <FontIcon x:Name="HealthStatusIcon" FontFamily="Segoe Fluent Icons" FontSize="16" Visibility="Collapsed" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="运行测试" Click="Health_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

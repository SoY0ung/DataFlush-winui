<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataFlushWinUI.Pages.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyDown="Page_KeyDown"
    IsTabStop="True"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="ProgressFillBrush" Color="#2EA043" />
        <DataTemplate x:Key="PaneItemTemplate">
            <StackPanel Width="{Binding ThumbnailWidth}" Margin="4">
                <Border Height="{Binding ThumbnailHeight}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Image Source="{Binding ImageUri}" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PaneListItemTemplate">
            <Grid MinHeight="32" Padding="8,4" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="PanePreviewItemsPanel">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PaneListItemsPanel">
            <ItemsStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid RowSpacing="8" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" MinHeight="36" Margin="0,-6,0,-2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OpenDataset_Click" MinHeight="32" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="打开数据集" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenCsvButton" Click="OpenCsv_Click" IsEnabled="False" MinHeight="32" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="打开CSV" />
                    </StackPanel>
                </Button>
                <DropDownButton x:Name="MoreButton">
                    <DropDownButton.Resources>
                        <Style TargetType="DropDownButton" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="10,4" />
                        </Style>
                    </DropDownButton.Resources>
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <TextBlock Text="更多" />
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="OpenDatasetDirItem" Text="打开数据集目录" Click="OpenDatasetInExplorer_Click" IsEnabled="False" />
                            <MenuFlyoutItem x:Name="OpenCsvDirItem" Text="打开CSV目录" Click="OpenCsvInExplorer_Click" IsEnabled="False" />
                            <MenuFlyoutItem x:Name="ResetCsvItem" Text="重置CSV" Click="ResetCsv_Click" IsEnabled="False" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <InfoBar
                x:Name="ToastBar"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="640"
                MinWidth="320"
                Margin="8,0"
                IsOpen="False"
                Severity="Success"
                Visibility="Collapsed"
                CloseButtonClick="ToastBar_CloseButtonClick" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Click="Undo_Click" IsEnabled="False" MinHeight="32" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        <TextBlock Text="撤销" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="PreviewToggle" Click="PreviewToggle_Click" MinHeight="32" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE890;" FontSize="14" />
                        <TextBlock Text="预览窗口" />
                    </StackPanel>
                </ToggleButton>
                <DropDownButton x:Name="ProgressButton" MinHeight="32" Padding="10,4">
                    <DropDownButton.Flyout>
                        <Flyout>
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MinWidth" Value="276" />
                                    <Setter Property="Padding" Value="12,10" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="CleanProgressBar" Height="20" Maximum="100" CornerRadius="10" VerticalAlignment="Center" Foreground="{StaticResource ProgressFillBrush}" />
                                    <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0%" Opacity="0.72" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="ProgressRemainingText" Text="剩余：0" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ProgressCountText" Text="0/0" HorizontalAlignment="Right" Opacity="0.72" />
                                </Grid>
                            </Grid>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="2*" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="RightColumn" Width="1*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="类别" VerticalAlignment="Center" />
                            <ComboBox x:Name="PaneAClass" Width="180" SelectionChanged="PaneClass_SelectionChanged" />
                        </StackPanel>
                        <TextBlock x:Name="PaneAStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <DropDownButton x:Name="PaneAMode" ToolTipService.ToolTip="显示模式" Padding="8,4" MinWidth="58" MinHeight="32"><DropDownButton.Content><FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="16" /></DropDownButton.Content><DropDownButton.Flyout><Flyout><StackPanel Orientation="Horizontal" Spacing="4" Padding="4"><Button Tag="A:preview" Click="ModeIcon_Click" Padding="8" ToolTipService.ToolTip="图片"><FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" /></Button><Button Tag="A:list" Click="ModeIcon_Click" Padding="8" ToolTipService.ToolTip="列表"><FontIcon Glyph="&#xE8FD;" /></Button></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton>
                            <DropDownButton ToolTipService.ToolTip="缩放" Padding="8,4" MinWidth="58" MinHeight="32">
                                <DropDownButton.Content>
                                    <FontIcon Glyph="&#xE8A3;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                                </DropDownButton.Content>
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="10" Padding="4" MinWidth="132">
                                            <TextBlock Text="缩放(Ctrl+滚轮)" FontWeight="SemiBold" />
                                            <Slider x:Name="PaneAZoom" Minimum="80" Maximum="220" Value="132" Width="132" ValueChanged="Zoom_ValueChanged" />
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <GridView x:Name="PaneAList" SelectionMode="Extended" IsItemClickEnabled="True" CanDragItems="True" AllowDrop="True" CanReorderItems="False" ItemClick="Image_ItemClick" SelectionChanged="PaneSelection_SelectionChanged" RightTapped="Pane_RightTapped" ItemTemplate="{StaticResource PaneItemTemplate}" ItemsPanel="{StaticResource PanePreviewItemsPanel}" />
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="PaneASelectionRect" Visibility="Collapsed" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" Background="#332EA043" CornerRadius="3" />
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>
            <primitives:Thumb Grid.Column="1" DragDelta="VerticalSplitter_DragDelta" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RightTopRow" Height="1*" MinHeight="160" />
                    <RowDefinition Height="8" />
                    <RowDefinition x:Name="RightBottomRow" Height="1*" MinHeight="160" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="类别" VerticalAlignment="Center"/><ComboBox x:Name="PaneBClass" Width="180" SelectionChanged="PaneClass_SelectionChanged"/></StackPanel><TextBlock x:Name="PaneBStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><DropDownButton x:Name="PaneBMode" ToolTipService.ToolTip="显示模式" Padding="8,4" MinWidth="58" MinHeight="32"><DropDownButton.Content><FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="16" /></DropDownButton.Content><DropDownButton.Flyout><Flyout><StackPanel Orientation="Horizontal" Spacing="4" Padding="4"><Button Tag="B:preview" Click="ModeIcon_Click" Padding="8" ToolTipService.ToolTip="图片"><FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" /></Button><Button Tag="B:list" Click="ModeIcon_Click" Padding="8" ToolTipService.ToolTip="列表"><FontIcon Glyph="&#xE8FD;" /></Button></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton><DropDownButton ToolTipService.ToolTip="缩放" Padding="8,4" MinWidth="58" MinHeight="32"><DropDownButton.Content><FontIcon Glyph="&#xE8A3;" FontFamily="Segoe Fluent Icons" FontSize="16" /></DropDownButton.Content><DropDownButton.Flyout><Flyout><StackPanel Spacing="10" Padding="4" MinWidth="132"><TextBlock Text="缩放(Ctrl+滚轮)" FontWeight="SemiBold" /><Slider x:Name="PaneBZoom" Minimum="80" Maximum="220" Value="132" Width="132" ValueChanged="Zoom_ValueChanged"/></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton></StackPanel></Grid>
                        <Grid Grid.Row="1">
                            <GridView x:Name="PaneBList" SelectionMode="Extended" IsItemClickEnabled="True" CanDragItems="True" AllowDrop="True" CanReorderItems="False" ItemClick="Image_ItemClick" SelectionChanged="PaneSelection_SelectionChanged" RightTapped="Pane_RightTapped" ItemTemplate="{StaticResource PaneItemTemplate}" ItemsPanel="{StaticResource PanePreviewItemsPanel}" />
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="PaneBSelectionRect" Visibility="Collapsed" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" Background="#332EA043" CornerRadius="3" />
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
                <primitives:Thumb Grid.Row="1" DragDelta="HorizontalSplitter_DragDelta" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="类别" VerticalAlignment="Center"/><ComboBox x:Name="PaneCClass" Width="180" SelectionChanged="PaneClass_SelectionChanged"/></StackPanel><TextBlock x:Name="PaneCStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><DropDownButton x:Name="PaneCMode" ToolTipService.ToolTip="显示模式" Padding="8,4" MinWidth="58" MinHeight="32"><DropDownButton.Content><FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="16" /></DropDownButton.Content><DropDownButton.Flyout><Flyout><StackPanel Orientation="Horizontal" Spacing="4" Padding="4"><Button Tag="C:preview" Click="ModeIcon_Click" Padding="8" ToolTipService.ToolTip="图片"><FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" /></Button><Button Tag="C:list" Click="ModeIcon_Click" Padding="8" ToolTipService.ToolTip="列表"><FontIcon Glyph="&#xE8FD;" /></Button></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton><DropDownButton ToolTipService.ToolTip="缩放" Padding="8,4" MinWidth="58" MinHeight="32"><DropDownButton.Content><FontIcon Glyph="&#xE8A3;" FontFamily="Segoe Fluent Icons" FontSize="16" /></DropDownButton.Content><DropDownButton.Flyout><Flyout><StackPanel Spacing="10" Padding="4" MinWidth="132"><TextBlock Text="缩放(Ctrl+滚轮)" FontWeight="SemiBold" /><Slider x:Name="PaneCZoom" Minimum="80" Maximum="220" Value="132" Width="132" ValueChanged="Zoom_ValueChanged"/></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton></StackPanel></Grid>
                        <Grid Grid.Row="1">
                            <GridView x:Name="PaneCList" SelectionMode="Extended" IsItemClickEnabled="True" CanDragItems="True" AllowDrop="True" CanReorderItems="False" ItemClick="Image_ItemClick" SelectionChanged="PaneSelection_SelectionChanged" RightTapped="Pane_RightTapped" ItemTemplate="{StaticResource PaneItemTemplate}" ItemsPanel="{StaticResource PanePreviewItemsPanel}" />
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="PaneCSelectionRect" Visibility="Collapsed" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" Background="#332EA043" CornerRadius="3" />
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Page>



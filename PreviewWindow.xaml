<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DataFlushWinUI.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DataFlush 预览">
    <Grid x:Name="WindowRoot" KeyDown="Window_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="PreviewTitleBar" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="TopMostButton"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                Padding="8,4"
                IsTabStop="False"
                Click="TopMostButton_Click"
                ToolTipService.ToolTip="始终置顶">
                <FontIcon Glyph="&#xE718;" FontSize="14" />
            </ToggleButton>
            <TextBlock
                x:Name="PreviewTitleText"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="DataFlush 预览"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />
        </Grid>
        <Grid x:Name="RootGrid" Grid.Row="1" Background="Black" PointerWheelChanged="RootGrid_PointerWheelChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InfoColumn" Width="280" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="ImageDragSurface" Background="Transparent" PointerPressed="ImageDragSurface_PointerPressed" PointerMoved="ImageDragSurface_PointerMoved" PointerReleased="ImageDragSurface_PointerReleased" PointerCanceled="ImageDragSurface_PointerCanceled">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Grid>
            <Border x:Name="AiPanel" Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="AiClassText" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="AiCertaintyText" FontSize="16" />
                <TextBlock x:Name="AiInfoText" TextWrapping="Wrap" />
            </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
